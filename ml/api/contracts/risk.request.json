{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-advisor.local/schemas/risk.request.json",
  "title": "RiskRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticker"],
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1,
      "description": "Instrument ticker to score."
    },
    "as_of": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Optional as-of date (YYYY-MM-DD)."
    },
    "lookback_days": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Optional lookback window in trading days."
    }
  }
}
