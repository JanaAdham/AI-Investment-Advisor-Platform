{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-advisor.local/schemas/anomaly.request.json",
  "title": "AnomalyRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticker"],
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1,
      "description": "Instrument ticker to check."
    },
    "as_of": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Optional as-of date (YYYY-MM-DD)."
    },
    "observed_return": {
      "type": ["number", "null"],
      "description": "Optional observed return (e.g. -0.05 for -5%)."
    },
    "lookback_days": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Optional historical lookback in trading days."
    }
  }
}
